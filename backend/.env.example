# Copy this file to backend/.env for local development. Pydantic Settings loads
# that file automatically; environment variables override values from the file.
APP_ENV=development
APP_NAME=Tabular Workbench

# Required locally: use the existing MySQL database and credentials for your machine.
DATABASE_URL=mysql+pymysql://tabular_user:<PASSWORD>@127.0.0.1:3306/tabular_workbench?charset=utf8mb4

# Production: set DATABASE_URL in Render to the Neon PostgreSQL connection URL.
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>/<database>?sslmode=require

CORS_ORIGINS=http://localhost:5173,https://tabular-workbench.vercel.app
MAX_UPLOAD_MB=20
SESSION_TTL_HOURS=6
LOG_LEVEL=INFO
